/delete-node/ &psm_partition;

/ {
	sim_flash: sim_flash {
		compatible = "zephyr,sim-flash";
		erase-value = <0xff>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			psm_partition: partition@0 {
				label = "psm";
				reg = <0x00000000 0x8000>;
			};
		};
	};
};
