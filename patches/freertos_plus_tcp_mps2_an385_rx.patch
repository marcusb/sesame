diff --git a/source/portable/NetworkInterface/MPS2_AN385/NetworkInterface.c b/source/portable/NetworkInterface/MPS2_AN385/NetworkInterface.c
index 2c354673..14cf9175 100644
--- a/source/portable/NetworkInterface/MPS2_AN385/NetworkInterface.c
+++ b/source/portable/NetworkInterface/MPS2_AN385/NetworkInterface.c
@@ -162,8 +162,19 @@ static void prvRxTask( void * pvParameters )
             xRxEvent.pvData = ( void * ) pxNetworkBuffer;
 
             pxNetworkBuffer->pxInterface = pxMyInterface;
+            /* Use the matched endpoint based on packet contents. The previous
+             * "single endpoint" hack of always routing to pxNetworkEndPoints
+             * forced every IPv6 packet (NS, NA, RA, MLD) to be processed by
+             * the IPv4 endpoint, which then dropped them in
+             * prvProcessICMPMessage_IPv6's bIPv6 check. */
             pxNetworkBuffer->pxEndPoint = FreeRTOS_MatchingEndpoint( pxMyInterface, pxNetworkBuffer->pucEthernetBuffer );
-            pxNetworkBuffer->pxEndPoint = pxNetworkEndPoints; /*temporary change for single end point */
+            if( pxNetworkBuffer->pxEndPoint == NULL )
+            {
+                /* Fall back to the first endpoint so packets we can't match
+                 * (e.g. broadcast/multicast that aren't addressed to a
+                 * specific endpoint) still get a chance at processing. */
+                pxNetworkBuffer->pxEndPoint = pxNetworkEndPoints;
+            }
 
             if( xSendEventStructToIPTask( &xRxEvent, ( TickType_t ) 0 ) == pdFAIL )
             {
@@ -196,6 +207,16 @@ static uint32_t prvLowLevelInput( NetworkBufferDescriptor_t ** pxNetworkBuffer )
             ulReceivedBytes = smsc9220_receive_by_chunks( dev,
                                                           ( char * ) ( ( *pxNetworkBuffer )->pucEthernetBuffer ),
                                                           ulMessageLength ); /* not used */
+            /* SMSC9220 RX_STATUS PKT_LENGTH includes the 4-byte FCS. The
+             * upper FreeRTOS+TCP IPv6 size check (xCheckIPv6SizeFields)
+             * compares uxBufferLength against the IPv6 PayloadLength field
+             * exactly, so the FCS bytes must not be counted as payload —
+             * otherwise every IPv6 packet (NS, NA, RA, MLD, ICMPv6) gets
+             * dropped at "location 4". */
+            if( ulReceivedBytes >= 4U )
+            {
+                ulReceivedBytes -= 4U;
+            }
             ( *pxNetworkBuffer )->xDataLength = ulReceivedBytes;
         }
         else
