/dts-v1/;
#include "../../../soc/nxp/88mw320/88mw320.dtsi"
#include <dt-bindings/pinctrl/mw320-pinctrl.h>
#include "genie_idcm.dts"

/ {
	model = "Marvell MW302 RAM Execution";
	compatible = "marvell,mw302-ram", "nxp,88mw320";

 chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	memory@20000000 {
		device_type = "memory";
		/* Use sram1 for both code and data in RAM build */
		reg = <0x20000000 0x20000>;
	};

	
};

&pinctrl {
	uart0_default: uart0_default {
		group0 {
			pinmux = <MW320_PINMUX(2, 2)>,
			         <MW320_PINMUX(3, 2)>;
			bias-pull-up;
		};
	};

	gpio_default: gpio_default {
		group0 {
			pinmux = <MW320_PINMUX(16, 0)>,
			         <MW320_PINMUX(27, 0)>,
			         <MW320_PINMUX(40, 0)>,
			         <MW320_PINMUX(41, 0)>,
			         <MW320_PINMUX(42, 0)>,
			         <MW320_PINMUX(43, 0)>;
			bias-pull-up;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
	pinctrl-0 = <&gpio_default>;
	pinctrl-names = "default";
};

&gpio1 {
	status = "okay";
};
