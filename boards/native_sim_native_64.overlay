/ {
	aliases {
		pic-uart = &uart1;
		pic-rst = &pic_rst;
		pic-wake = &pic_wake;
		pic-sbl = &pic_sbl;
	};

	buttons {
		compatible = "gpio-keys";
		pic_rst: pic_rst {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "PIC Reset";
		};
		pic_wake: pic_wake {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "PIC Wake";
		};
		pic_sbl: pic_sbl {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "PIC SBL";
		};
	};
};

&uart1 {
	status = "okay";
	compatible = "zephyr,native-tty-uart";
	current-speed = <115200>;
	serial-port = "/tmp/sesame_pic_uart";
};

/ {
	retained_sram: sram@2001fc00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2001fc00 1024>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";
	};
};

&flashcontroller0 {
	reg = <0x0 0x400000>;
};

&flash0 {
	reg = <0x0 0x400000>;
	/delete-node/ partitions;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot2_partition: partition@0 {
			label = "boot2";
			reg = <0x00000000 0x00010000>;
		};
		boot_partition: mcuboot_partition: mcuboot0_partition: partition@10000 {
			label = "mcuboot";
			reg = <0x00010000 0x00020000>;
		};
		mcuboot1_partition: partition@30000 {
			label = "mcuboot-1";
			reg = <0x00030000 0x00020000>;
		};
		slot0_partition: partition@50000 {
			label = "image-0";
			reg = <0x00050000 0x00160000>;
		};
		slot1_partition: partition@1b0000 {
			label = "image-1";
			reg = <0x001B0000 0x00160000>;
		};
		storage_partition: partition@310000 {
			label = "storage";
			reg = <0x00310000 0x00040000>;
		};
	};
};
