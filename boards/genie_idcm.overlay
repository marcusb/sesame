/ {
	sram@2001fc00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2001fc00 1024>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <1>;

			boot_info0: boot_info@0 {
				compatible = "zephyr,retention";
				status = "okay";
				reg = <0x0 0x400>;
			};
		};
	};

	chosen {
		zephyr,flash = &flash0;
		zephyr,code-partition = &linker_partition;
		zephyr,bootloader-info = &boot_info0;
	};
};

&sram1 {
	reg = <0x20000000 0x1FC00>;
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		linker_partition: partition@1f000000 {
			label = "linker";
			reg = <0x0 0x170000>;
		};
	};
};
